<Window x:Class="Telhai.DotNet.PlayerProject.EditTrackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Telhai.DotNet.PlayerProject"
        mc:Ignorable="d"
        Title="Edit Song Info" Height="450" Width="400" 
        Icon="pack://application:,,,/Pictures/Icon.png"
        Background="#333" Foreground="White" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <StackPanel>
            <TextBlock Text="Song Title:" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Track.Title, UpdateSourceTrigger=PropertyChanged}" Background="#444" Foreground="White" Padding="5"/>

            <TextBlock Text="Gallery Images:" Margin="0,15,0,5" FontWeight="Bold"/>
            <ListBox x:Name="lstUserImages" ItemsSource="{Binding UserImages}" Height="150" Background="#222" Foreground="White"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Add Image" Command="{Binding AddImageCommand}" Width="100" Margin="5"/>
                <Button Content="Remove Selected" Command="{Binding RemoveImageCommand}" 
                        CommandParameter="{Binding SelectedItem, ElementName=lstUserImages}" Width="110" Margin="5"/>
            </StackPanel>

            <Button Content="Save and Close" Click="BtnSave_Click" Height="40" Margin="0,30,0,0" 
                    Background="#007ACC" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
